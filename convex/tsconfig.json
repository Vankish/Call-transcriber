{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    // TypeScript 6 ya no carga @types solos. Hace falta "node" para
    // `process.env`, que Convex sí da en su runtime normal.
    "types": ["node"]
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
