# Supabase — claves PUBLICABLES (seguras de exponer, protegidas por RLS).
# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# NOTA: la Groq API key NO va aquí ni en la nube — cada usuario la introduce en
# Ajustes y se guarda solo en el config.json local de la app.

# Nube de Convex (docs/nube/CONTRATO.md). Solo la direccion publica del
# despliegue, nunca una clave. Vacia = la app se compila sin nube y no enseña la
# pestaña Nube. `npm run build` la deja tambien en dist/cloud-config.json para
# que la lea el proceso principal (electron/cloud/convex-url.cjs).
VITE_CONVEX_URL=
